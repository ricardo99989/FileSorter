{
  "name": "filesorter",
  "productName": "FileSorter",
  "version": "3.3.1",
  "description": "把文件整理做安全的 Windows 桌面工具：预览后执行、多步撤销、自定义规则、查重与标签",
  "main": "src/main/index.js",
  "license": "MIT",
  "author": {
    "name": "FileSorter Contributors"
  },
  "keywords": [
    "electron",
    "file-manager",
    "file-organizer",
    "duplicate-finder",
    "glassmorphism",
    "virtual-scroll",
    "windows"
  ],
  "private": false,
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "chokidar": "^4.0.3"
  }
}
